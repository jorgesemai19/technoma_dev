<?xml version="1.0"?>

<odoo>
    <record id="view_tree_lead_line" model="ir.ui.view">
        <field name="name">crm.lead.form.lead</field>
        <field name="model">crm.lead.line</field>
        <field name="arch" type="xml">
            <tree string="Productos" editable="bottom">
<!--                <field name="product_id"/>-->
                <field name="category_id" string='Categoria de Producto' options="{'no_create_edit': True, 'no_create': True}"/>
<!--                <field name="product_tmpl_id"/>-->
                <field name="name" string="Descripcion" widget="section_and_note_text"/>
                <field name="proveedor_id" options="{'no_create_edit': True, 'no_create': True}"
                domain="[('supplier', '=', True)]" context="{'default_customer': 0, 'search_default_supplier': 1,
                'default_supplier': 1, 'default_is_company': True, 'show_vat': True}"/>
                <field name="product_qty" string="Cantidad"/>
                <field name="price_unit" string="Precio Unitario"/>
                <field name="margen" string="Margen (%)" widget="integer"/>
                <field name="costo_unitario"/>
                <field name="costo_total"/>
                <field name="planned_revenue" string="Ingresos previstos"/>
                <field name="expected_revenue" string="Ingresos esperados"/>
            </tree>
        </field>
    </record>
</odoo>
