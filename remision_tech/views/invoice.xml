<odoo>
  <data>
            <record model="ir.ui.view" id="account_invoice_form_inherited">
            <field name="name">account.invoice.remi.inh</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="paraguay_backoffice.account_invoice_form_inherited"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='tipo_de_documento']" position="after">
                    <field name="partner_id" invisible="1"/>
                    <field name="remision_ids" domain="[('numero_remision','!=', None),('partner_id','child_of',partner_id)]" widget="many2many" options="{'no_create': True}">
                        <tree>
                            <field name="name"/>
                            <field name="numero_remision"/>
                            <field name="state" invisible="1"/>
                        </tree>
                    </field>
                </xpath>
            </field>
          </record>

  </data>
</odoo>