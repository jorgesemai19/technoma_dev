<odoo>
    <data>


        <record id="paperformat_remision_technoma" model="report.paperformat">
            <field name="name">A4</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">300</field>
            <field name="page_width">210</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
        </record>

                            <!--Remision-->
        <report
                id="remision_report_technoma"
                model="stock.picking"
                string="Remision Technoma"
                report_type="qweb-pdf"
                name="remision_tech.report_remision_technoma"
                file="remision_tech.report_remision_technoma"
                paperformat="paperformat_remision_technoma"
                print_report_name="'Nota de Remision %s' % (object.numero_remision)"
        />

