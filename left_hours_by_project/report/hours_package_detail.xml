<odoo>
    <template id="hours_package_detail">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="header" >
                      <link rel="stylesheet" href="/left_hours_by_project/static/src/css/hours_package_report_style.css"/>
                        <br/>
                      <div class="col-8 pull-left">
                          <img t-att-src="'data:image/png;base64,%s' % to_text(o.company_id.logo)" width="200" height="60"/>
                      </div>
                      <div class="company_data">
                          <p><span t-field="o.company_id.name"></span></p>
                          <p><span t-field="o.company_id.street"></span></p>
                          <p><span t-field="o.company_id.city"></span>-<span t-field="o.company_id.country_id.name"></span></p>
                          <p><span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/></p>
                          <p><span>Pag: </span><span class="page" /> de <span class="topage" /></p>
                      </div>
                  </div>
                  <div class="page">
                      <link rel="stylesheet" href="/left_hours_by_project/static/src/css/hours_package_report_style.css"/>
                      <br/>
                      <br/>
                      <h4><center><stong>Hours Package Report</stong></center></h4>
                      <br/>
                      <div class="title" id="titulo">
                          <table class="table table-condensed">
                              <thead>
                                  <tr>
                                      <th class="text-right">Description</th>
                                      <th class="text-right">Partner</th>
                                      <th class="text-right">Approval date</th>
                                      <th class="text-right">Hours from budget</th>
                                      <th class="text-right">Hours used</th>
                                      <th class="text-right">Hours Available</th>
                                  </tr>
                              </thead>
                              <tbody>
                                  <tr>
                                      <td class="text-right"><span t-field="o.name"/></td>
                                      <td class="text-right"><span t-field="o.partner_id.name"/></td>
                                      <td class="text-right"><span t-field="o.approval_date"/></td>
                                      <td class="text-right"><span t-esc="'%02d:%02d' % (int(o.hours_from_budget), o.hours_from_budget % 1 * 60)"/></td>
                                      <td class="text-right"><span t-esc="'%02d:%02d' % (int(o.hours_used), o.hours_used % 1 * 60)"/></td>
                                      <td class="text-right"><span t-esc="'%02d:%02d' % (int(o.available_hours), o.available_hours % 1 * 60)"/></td>
                                  </tr>
                              </tbody>
                          </table>
                      </div>
                      <table class="table table-condensed">
                          <thead>
                              <tr>
                                  <th class="text-right">Date</th>
                                  <th class="text-right">Employee</th>
                                  <th class="text-right">Description</th>
                                  <th class="text-right">Start hour</th>
                                  <th class="text-right">Stop hour</th>
                                  <th class="text-right">Duration</th>
                              </tr>
                          </thead>
                          <tbody>
                              <tr colspan="3">
                                  <h5><center><strong>Timesheet lines</strong></center></h5>
                              </tr>
                              <tr t-foreach="o.analytic_line_ids" t-as="lines">
                                  <td class="text-right"><span t-field="lines.date"/></td>
                                  <td class="text-right"><span t-field="lines.employee_id.name"/></td>
                                  <td class="text-right"><span t-field="lines.name"/></td>
                                  <td class="text-right"><span t-esc="'%02d:%02d' % (int(lines.time_start), lines.time_start % 1 * 60)"/></td>
                                  <td class="text-right"><span t-esc="'%02d:%02d' % (int(lines.time_stop), lines.time_stop % 1 * 60)"/></td>
                                  <td class="text-right"><span t-esc="'%02d:%02d' % (int(lines.unit_amount), lines.unit_amount % 1 * 60)"/></td>
                              </tr>
                          </tbody>
                      </table>
<!--                              <tr t-foreach="o.get_updated_and_filter_object()" t-as="package">-->
<!--                                  <td>-->
<!--                                      <span t-att-style="style" t-esc="package['name']" style="color:white;"/>-->
<!--                                  </td>-->
<!--                                  <td class="text-right">-->
<!--                                      <span t-att-style="style" t-if="package['partner_id']" t-esc="package['partner_id'].name"/>-->
<!--                                  </td>-->
<!--                                  <td class="text-right">-->
<!--                                      <span t-att-style="style" t-esc="'%02d:%02d' % (int(package.hours_from_budget), package.hours_from_budget % 1 * 60)"/>-->
<!--                                  </td>-->
<!--                                  <td class="text-right">-->
<!--                                      <span t-att-style="style" t-esc="'%02d:%02d' % (int(package.hours_used), package.hours_used % 1 * 60)"/>-->
<!--                                  </td>-->
<!--                                  <td class="text-right">-->
<!--                                      <span t-att-style="style" t-esc="'%02d:%02d' % (int(package.available_hours), package.available_hours % 1 * 60)"/>-->
<!--                                  </td>-->
<!--                              </tr>-->
<!--                          </tbody>-->
<!--                      </table>-->
                  </div>
                </t>
            </t>
        </t>
    </template>
</odoo>