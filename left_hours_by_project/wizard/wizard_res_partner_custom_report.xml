<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="wizard_res_partner_custom_report_form" model="ir.ui.view">
            <field name="name">wizard.res.partner.custom.report.name</field>
            <field name="model">wizard.res.partner.custom.report</field>
            <field name="arch" type="xml">
                <form string="Report">
                    <group class="oe_title">
                        <field name="company_id" readonly="1" force_save="1"/>
                    </group>
                    <footer>
<!--                        <button name="print_report_package_hour" string="Download PDF" type="object" class="btn-primary"/>-->
                        <button name="print_report_package_hour_xls" string="Download XLSX" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="wizard_custom_partner_report_action" model="ir.actions.act_window">
            <field name="name">Partner custom report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">wizard.res.partner.custom.report</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="wizard_res_partner_custom_report_form"/>
            <field name="target">new</field>
        </record>

        <menuitem id="custom_report_contacts" name="Partner report" parent="contacts.res_partner_menu_contacts" action="left_hours_by_project.wizard_custom_partner_report_action" sequence="1"/>
    </data>
</odoo>