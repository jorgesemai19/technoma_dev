<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hours_package_helpdesk_ticket_inh_view" model="ir.ui.view">
            <field name="name">hours.package.helpdesk.ticket.inh.view</field>
            <field name="model">helpdesk.ticket</field>
            <field name="inherit_id" ref="helpdesk_timesheet.helpdesk_ticket_view_form_inherit_helpdesk_timesheet"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='timesheet_ids']/tree" position="inside">
                    <field name="hours_package_id" domain="[('partner_id', '=', parent.partner_id)]" options="{'no_create_edit': True, 'no_create': True}"/>
                    <field name="activity_type_id" options="{'no_create_edit': True, 'no_create': True}"/>
                </xpath>
            </field>
        </record>


    </data>
</odoo>