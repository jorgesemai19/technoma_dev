<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="account_analytic_line_inh_form_view" model="ir.ui.view">
            <field name="name">account.analytic.line.inh.form</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="timesheet_grid.timesheet_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='employee_id']" position="after">
                    <!-- Add your fields or attributes here -->
<!--                    <field name="partner_id"/>-->
                    <field name="hours_package_id"/>
                    <field name="extra_hours" widget="timesheet_uom"/>
                    <field name="activity_type_id"/>
                </xpath>
            </field>
        </record>
        <record id="account_analytic_inh_tree_view" model="ir.ui.view">
            <field name="name">account.analytic.inh.tree.view</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='project_id']" position="after">
                    <!-- Add new fields here -->
                    <field name="extra_hours"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>