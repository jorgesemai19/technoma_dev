<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="hours_package_timesheet_task_inh_view" model="ir.ui.view">
            <field name="name">hours.package.timesheet.task.inh.view</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='timesheet_ids']/tree" position="inside">
                    <field name="hours_package_id" domain="[('partner_id', '=', parent.partner_id)]" options="{'no_create_edit': True, 'no_create': True}"/>
                    <field name="activity_type_id" options="{'no_create_edit': True, 'no_create': True}"/>
                </xpath>
            </field>
        </record>

        <record id="hours_package_timesheet_project_task_inh_view" model="ir.ui.view">
            <field name="name">hours.package.timesheet.project.task.inh.view</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[not(@name)][1]/field[@name='timesheet_ids']/tree[1]/field[@name='role_id']" position="attributes">
                <attribute name="attrs">{}</attribute>
            </xpath>
            </field>
        </record>
    </data>
</odoo>