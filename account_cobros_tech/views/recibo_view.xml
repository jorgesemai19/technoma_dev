<odoo>
    <data>
        <record model="ir.ui.view" id="account_cobros_tech.recibos_form_view">
                    <field name="name">account.cobros.tech.recibos.form</field>
                    <field name="model">account.recibo</field>
                    <field name="inherit_id" ref="account_cobros_py.recibos_form_view"/>
                    <field name="arch" type="xml">
                        <button name="confirmar_recibo" position="after">
                            <button name="action_recibo_send" string="Enviar por Correo" type="object" states="confirmado" class="btn-primary"/>
                        </button>
                        <field name="talonario_id" position="replace">
                        </field>
                        <field name="name" position="replace">
                            <field name="name"/>
                        </field>
                        <field name="ultimo_numero" position="replace">
                        </field>
                    </field>
         </record>
    </data>
</odoo>