<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template and notification section -->
    <data noupdate="0">
        <record id="email_template_recibo_cobro" model="mail.template">
            <field name="name">Recibo: Enviar por correo</field>
            <field name="model_id" ref="account_cobros_tech.model_account_recibo"/>
            <field name="email_from">${object.cobrador.email_formatted |safe}</field>
            <field name="partner_to">${object.partner_id.id}</field>
            <field name="subject">${object.company_id.name} - Recibo (Nro ${object.name or 'n/a' })</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        % set doc_name = 'Recibo'
                        Estimad@ ${object.partner_id.name}
                        % if object.partner_id.parent_id:
                            (${object.partner_id.parent_id.name})
                        % endif
                        <br /><br />
                        Adjunto a este correo encontrará el
                        ${doc_name} de Cobranza Nro. <strong>${object.name}</strong>
                        en formato de archivo PDF.
                        <br /><br />
                        No dude en ponerse en contacto con nosotros si tiene alguna pregunta.
                    </p>
                </div>
            </field>
            <field name="report_template" ref="action_recibo_report"/>
            <field name="report_name">Recibo ${(object.name or '').replace('/','_')}</field>
            <field name="lang">${object.partner_id.lang}</field>
            <field name="user_signature" eval="False"/>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
