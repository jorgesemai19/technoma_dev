        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="presale.crm_lead_view_presale_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='generate_presale_project']" position="after">
                <button name="action_assign_presale" string="ASSIGN ME THIS PRESALE" type="object" style="background-color: #29897E; color: white"/>
            </xpath>
            <xpath expr="//field[@name='requiere_preventa']" position="after">
                <!-- Add your fields or attributes here -->
              <field name="presales_id" attrs="{'invisible': [('requiere_preventa', '=', False)]}"/>
            </xpath>
        </field>
    </record>
