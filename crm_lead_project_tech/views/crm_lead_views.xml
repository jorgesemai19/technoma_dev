<?xml version="1.0"?>

<odoo>
    <record id="crm_case_form_view_oppor_project" model="ir.ui.view">
        <field name="name">crm.lead.form.oppor.project</field>
        <field name="model">crm.lead</field>
        <field name="priority">21</field>
        <field name="inherit_id" ref="crm.crm_case_form_view_oppor"/>
        <field name="arch" type="xml">
            <button name="toggle_active" position="after">
                <button name="generar_proyecto_oportunidad" string="Generar Proyecto" type="object" class="oe_highlight"
                attrs="{'invisible': [('project_id', '!=', False)]}" groups="project.group_project_manager"/>
            </button>
            <field name="date_deadline" position="after">
                <field name="project_id"  attrs="{'invisible': [('project_id', '=', False)]}" readonly="1"/>
            </field>
        </field>
    </record>
</odoo>
