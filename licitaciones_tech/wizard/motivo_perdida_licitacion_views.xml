<?xml version="1.0"?>
<odoo>
        <record id="licitacion_perdida_view_form" model="ir.ui.view">
            <field name="name">licitacion.perdida.form</field>
            <field name="model">licitaciones_tech.licitacion.perdida</field>
            <field name="arch" type="xml">
                <form string="Motivo">
                    <group class="oe_title">
                        <field required="1" name="motivo_perdida_id" options="{'no_create_edit': True, 'no_create': True,
                        'no_open': True}"/>
                    </group>
                    <footer>
                        <button name="action_aplicar_motivo_perdida" string="Guardar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="perdida_action" model="ir.actions.act_window">
            <field name="name">Motivo de Perdida</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">licitaciones_tech.licitacion.perdida</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="licitacion_perdida_view_form"/>
            <field name="target">new</field>
        </record>
</odoo>
