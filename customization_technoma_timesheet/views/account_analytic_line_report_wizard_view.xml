<?xml version="1.0"?>
<odoo>
    <record id="view_account_analytic_line_report_wizard" model="ir.ui.view">
        <field name="name">account.analytic.line.report.wizard.form</field>
        <field name="model">account.analytic.line.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Analytic Line Report Wizard">
                <group>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="all_employees"/>
                    <field name="employee_id" attrs="{'invisible': [('all_employees', '=', True)]}"/>
                </group>
                <footer>
                    <button name="print_report" string="Print Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="action_account_analytic_line_report_wizard" model="ir.actions.act_window">
        <field name="name">Analytic Line Report Wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.analytic.line.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_account_analytic_line_report_wizard"/>
        <field name="target">new</field>
    </record>

    <record id="menu_item_account_analytic_line_report" model="ir.ui.menu">
        <field name="name">Analytic Line Report</field>
        <field name="action" ref="action_account_analytic_line_report_wizard"/>
        <field name="parent_id" ref="hr_timesheet.menu_hr_time_tracking"/> <!-- Reference the submenu you created -->
        <field name="sequence" eval="200"/>
    </record>

</odoo>
