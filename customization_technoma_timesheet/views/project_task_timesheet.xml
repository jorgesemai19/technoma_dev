<odoo>
    <record id="hr_timesheet_project_task_begin_end_form" model="ir.ui.view">
        <field name="name">hr.timesheet.project.task.begin.end.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited"/>
        <field name="mode">extension</field>
        <field name="arch" type="xml">
<!--            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[2]/field[@name='timesheet_ids']/tree[1]/field[@name='role_id']" position="replace">-->
