<odoo>
    <data>


        <record id="paper_format_overtime_tech" model="report.paperformat">
            <field name="name">A4</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">300</field>
            <field name="page_width">210</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">40</field>
            <field name="margin_bottom">32</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">35</field>
            <field name="dpi">90</field>
        </record>

                            <!--Overtime Report-->

        <record id="overtime_report_tec" model="ir.actions.report">
            <field name="name">Overtime hours</field>
            <field name="model">account.analytic.line.report.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">customization_technoma_timesheet.report_account_analytic_line</field>
            <field name="report_file">customization_technoma_timesheet.report_account_analytic_line</field>
            <field name="binding_model_id" ref="model_account_analytic_line_report_wizard"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>